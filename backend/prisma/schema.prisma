generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================
enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  CANCEL_REQUESTED  
}

enum BookingType {
  TOURNAMENT
  CASUAL
  WEEKLY
}

enum CourtStatus {
  AVAILABLE 
  OCCUPIED 
  ALMOST_DONE 
  MAINTENANCE 
  CLOSED 
}

enum CourtType {
  OUTDOOR
  INDOOR
}


enum PaymentStatus {
  PENDING 
  PARTIALLY_PAID 
  PAID 
  FAILED 
  REFUNDED 
  CANCELLED
  EXPIRED
}

enum REFUNDSTATUS {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum PaymentMethod {
  CASH 
  BANK_TRANSFER
  CREDIT_CARD 
  MOMO
  ZALOPAY 
  VNPAY
  PAYOS
}

// ================= MODELS =================
model Roles {
  roleID      String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users Users[]
}

model Users {
  userID              String   @id @default(uuid())
  full_name           String
  password            String
  phone               String   @unique @db.VarChar(10)
  address             String?
  role_id             String
  bank_account_number String?
  bank_account_owner  String?
  bank_name           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  role                Roles    @relation(fields: [role_id], references: [roleID])

  bookings   Bookings[]
  feedbacks   Feedbacks[]
  tournaments Tournaments[]
}

model Courts {
  courtID        String      @id @default(uuid())
  name           String
  type           CourtType   @default(INDOOR)
  status         CourtStatus @default(AVAILABLE)
  image          String?
  multiplier     Float       
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  bookings          Bookings[]
  feedbacks          Feedbacks[]
}

model Slots {
  slotID        String        @id @default(uuid())
  slot_name     String
  start_time    String
  end_time      String
  price         Float
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bookingSlots BookingSlots[]
}

model Bookings {
  bookingID      String        @id @default(uuid())
  booking_date   DateTime
  status         BookingStatus @default(PENDING)
  total_price    Float
  deposit_amount Float
  booking_type   BookingType   @default(CASUAL)
  court_id       String?
  court_type     CourtType?
  user_id        String?
  phone_user     String?
  discount       Decimal?      @db.Decimal(4, 2)
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  court       Courts?        @relation(fields: [court_id], references: [courtID])
  user        Users?         @relation(fields: [user_id], references: [userID])
  payments    Payments[]
  bookingSlots BookingSlots[]
}

model BookingSlots {
  bookingSlotID String   @id @default(uuid())
  booking_id    String
  slot_id       String
  date          DateTime
  is_recurring  Boolean
  recurring_day Int?
  num_weeks     Int?

  booking Bookings @relation(fields: [booking_id], references: [bookingID])
  slot    Slots    @relation(fields: [slot_id], references: [slotID])
}

model Payments {
  paymentID        String        @id @default(uuid())
  booking_id       String
  payment_method   PaymentMethod
  status           PaymentStatus @default(PENDING)
  image            String?
  transaction_id   String?
  order_code       Int?          @unique
  paid_amount      Float         @default(0)
  qr_code_url      String?
  payment_url      String?
  payment_link_id  String?
  payment_deadline DateTime?
  refund_amount    Float         @default(0)
  refund_reason    String?
  refund_date      DateTime?
  refund_percentage Int?         
  refund_status    REFUNDSTATUS? 
  bank_name        String?
  bank_account_number String?
  bank_account_owner  String?
  admin_note       String?       
  processed_by     String?       
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking       Bookings        @relation(fields: [booking_id], references: [bookingID])
}

model Feedbacks {
  feedbackID String   @id @default(uuid())
  user_id    String
  court_id   String
  rating     Int
  comment    String?
  is_anonymous Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  Users  @relation(fields: [user_id], references: [userID])
  court Courts @relation(fields: [court_id], references: [courtID])
}

model Tournaments {
  tournamentID String   @id @default(uuid())
  name         String
  start_day    DateTime
  description  String?
  status       String
  max_teams    Int
  user_id      String?
  phone_user   String?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  Users?  @relation(fields: [user_id], references: [userID])
}

model Blogs {
  blogID      String @id @default(uuid())
  title       String 
  content     String    @db.LongText
  image       String?
  author      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

}

