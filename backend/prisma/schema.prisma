generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================
enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum BookingType {
  TOURNAMENT
  CASUAL
  WEEKLY
}

enum CourtStatus {
  AVAILABLE // Sân trống
  OCCUPIED //đang có người chơi
  MAINTENANCE // bảo trì
  CLOSED // ngưng hoạt động
}

enum CourtType {
  OUTDOOR
  INDOOR
}

enum MatchStatus {
  SCHEDULED
  ONGOING
  FINISHED
  CANCELED
}

enum RecurringDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum PaymentStatus {
  PENDING // Chờ thanh toán
  PARTIALLY_PAID // Đã thanh toán một phần
  PAID // Đã thanh toán đủ
  FAILED // Thanh toán thất bại
  REFUNDED // Đã hoàn tiền
  CANCELLED // Đã hủy giao dịch
}

enum PaymentMethod {
  CASH // Tiền mặt tại quầy
  BANK_TRANSFER // Chuyển khoản ngân hàng
  CREDIT_CARD // Thẻ tín dụng / ghi nợ
  MOMO // Ví MoMo
  ZALOPAY // Ví ZaloPay
  VNPAY // Thanh toán qua VNPAY
}

// ================= MODELS =================
model Roles {
  roleID      String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users Users[]
}

model Users {
  userID              String   @id @default(uuid())
  full_name           String
  email               String   @unique
  password            String
  phone               String?
  address             String?
  role_id             String
  bank_account_number String?
  bank_account_owner  String?
  bank_name           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  role                Roles    @relation(fields: [role_id], references: [roleID])

  bookings   Bookings[]
  feedback   Feedback[]
  teamMember TeamMembers[]
}

model Courts {
  courtID        String      @id @default(uuid())
  name           String
  type           CourtType   @default(INDOOR)
  status         CourtStatus @default(AVAILABLE)
  image          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  bookings          Bookings[]
  feedback          Feedback[]
  tournamentMatches TournamentMatches[]
}

model Slots {
  slotID        String        @id @default(uuid())
  slot_name     String
  start_time    String
  end_time      String
  price         Float
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bookingSlot BookingSlot[]
}

model Bookings {
  bookingID      String        @id @default(uuid())
  booking_date   DateTime
  status         BookingStatus @default(PENDING)
  total_price    Float
  deposit_amount Float
  booking_type   BookingType   @default(CASUAL)
  court_id       String?
  user_id        String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  court       Courts?       @relation(fields: [court_id], references: [courtID])
  user        Users         @relation(fields: [user_id], references: [userID])
  payments    Payments[]
  bookingSlot BookingSlot[]
}

model BookingSlot {
  bookingSlotID String   @id @default(uuid())
  booking_id    String
  slot_id       String
  date          DateTime
  is_recurring  Boolean
  recurring_day RecurringDay? //cho phép chọn nhiều ngày trong tuần
  num_weeks     Int?

  booking Bookings @relation(fields: [booking_id], references: [bookingID])
  slot    Slots    @relation(fields: [slot_id], references: [slotID])
}

model Payments {
  paymentID      String        @id @default(uuid())
  booking_id     String
  payment_method PaymentMethod
  status         PaymentStatus @default(PENDING)
  image          String?
  transaction_id String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  booking Bookings @relation(fields: [booking_id], references: [bookingID])
}

model Feedback {
  feedbackID String   @id @default(uuid())
  user_id    String
  court_id   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  Users  @relation(fields: [user_id], references: [userID])
  court Courts @relation(fields: [court_id], references: [courtID])
}

model Tournaments {
  tournamentID String   @id @default(uuid())
  name         String
  start_day    DateTime
  end_day      DateTime
  description  String?
  status       String
  max_teams    Int
  prize        Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leaderBoards      LeaderBoards[]
  tournamentMatches TournamentMatches[]
}

model TournamentTeams {
  tournamentTeamID String   @id @default(uuid())
  team_name        String
  member_count     Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  matchesAsTeam1  TournamentMatches[] @relation("Team1")
  matchesAsTeam2  TournamentMatches[] @relation("Team2")
  matchesAsWinner TournamentMatches[] @relation("WinnerTeam")
  members         TeamMembers[]
}

model TeamMembers {
  teamMemberID       String   @id @default(uuid())
  tournament_team_id String
  user_id            String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tournamentTeam TournamentTeams @relation(fields: [tournament_team_id], references: [tournamentTeamID])
  user           Users           @relation(fields: [user_id], references: [userID])
}

model TournamentMatches {
  tournamentMatchID String   @id @default(uuid())
  tournament_id     String
  team1_id          String
  team2_id          String
  court_id          String?
  score_team1       Int?
  score_team2       Int?
  status            String
  round             Int
  start_time        DateTime
  end_time          DateTime
  winner_team_id    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tournament Tournaments      @relation(fields: [tournament_id], references: [tournamentID])
  team1      TournamentTeams  @relation("Team1", fields: [team1_id], references: [tournamentTeamID])
  team2      TournamentTeams  @relation("Team2", fields: [team2_id], references: [tournamentTeamID])
  winnerTeam TournamentTeams? @relation("WinnerTeam", fields: [winner_team_id], references: [tournamentTeamID])
  court      Courts?          @relation(fields: [court_id], references: [courtID])
}

model LeaderBoards {
  leaderBoardID  String   @id @default(uuid())
  tournament_id  String
  team_id        String
  matches_played Int
  wins           Int
  losses         Int
  draws          Int
  points         Int
  rank           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tournament Tournaments @relation(fields: [tournament_id], references: [tournamentID])
}
